{
  "schema_version": "riceai-backbone-benchmark/v1",
  "benchmark_id": "rice_11class_large_grouped_benchmark_v1",
  "status": "locked_ready_for_training",
  "task": {
    "type": "single_label_image_classification",
    "description": "Phân loại 11 nhãn bệnh, sâu hại, cỏ dại và trạng thái cây lúa từ một ảnh RGB."
  },
  "data": {
    "dataset_root": "../../research/dataset_11_large_v1",
    "split_manifest": "../../research/splits/dataset_11_large_grouped_v1_benchmark.csv",
    "split_metadata": "../../research/splits/dataset_11_large_grouped_v1_benchmark.metadata.json",
    "manifest_id": "dataset_11_large_grouped_v1_benchmark",
    "split_seed": 2026,
    "split_level": "canonical_phash64_connected_components_hamming_le_8_after_exact_pixel_and_exact_phash_dedup",
    "fractions": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    },
    "cross_label_duplicate_policy": "exclude_all_exact_pixel_or_exact_canonical_phash_cross_label_conflicts",
    "class_count": 11,
    "internal_test_role": "secondary_internal_grouped_holdout",
    "external_test_root": "../../research/external_test_11class",
    "external_test_manifest": "../../research/external_test_11class_manifest_v1.csv",
    "external_test_lock_file": "../../research/external_test_11class_lock_v1.json",
    "external_test_required_for_primary_publication_claim": true
  },
  "release_gates": {
    "dataset_integrity": "passed",
    "group_leakage_audit": "passed",
    "cross_label_duplicate_audit": "passed_by_conservative_exclusion",
    "external_test_isolation": "passed_hash_and_phash_distance_gt_8",
    "external_test_lock": "locked_1100_images_100_per_class",
    "training_allowed": true
  },
  "models": [
    "mobilenetv2",
    "mobilenetv3large",
    "resnet18",
    "efficientnetb0",
    "shufflenetv2_1_0x",
    "densenet121"
  ],
  "implementation": {
    "framework": "pytorch_torchvision",
    "weights_source": "official_torchvision_imagenet1k",
    "input_range": "rgb_float_0_1_then_imagenet_normalize",
    "imagenet_mean": [0.485, 0.456, 0.406],
    "imagenet_std": [0.229, 0.224, 0.225],
    "batchnorm_policy": "freeze_running_statistics_and_parameters_in_both_stages",
    "deterministic_algorithms": true,
    "cublas_workspace_config": ":4096:8",
    "allow_tf32": false
  },
  "training": {
    "input_shape": [224, 224, 3],
    "transfer_learning_weights": "imagenet",
    "batch_size": 32,
    "head_epochs": 15,
    "fine_tune_epochs": 30,
    "optimizer": "adam",
    "head_learning_rate": 0.001,
    "fine_tune_learning_rate": 0.00001,
    "dropout": 0.4,
    "early_stopping_patience": 5,
    "reduce_lr_factor": 0.2,
    "reduce_lr_min": 0.0000001,
    "class_weighting": {
      "method": "effective_number",
      "beta": 0.999,
      "minimum": 0.25,
      "maximum": 5.0
    },
    "augmentation": {
      "application": "dynamic_train_only_after_split",
      "horizontal_flip_probability": 0.5,
      "rotation_degrees": 20.0,
      "translation_fraction": 0.1,
      "scale_range": [0.85, 1.15],
      "brightness": 0.15,
      "contrast": 0.15
    },
    "selection_metric": "validation_macro_f1",
    "training_seeds": [42, 123, 2026],
    "test_must_not_select_model_or_hyperparameters": true,
    "models_to_train": [
      "mobilenetv2",
      "mobilenetv3large",
      "resnet18",
      "efficientnetb0",
      "shufflenetv2_1_0x",
      "densenet121"
    ]
  },
  "evaluation": {
    "primary_metric": "macro_f1",
    "required_metrics": [
      "accuracy",
      "balanced_accuracy",
      "macro_precision",
      "macro_recall",
      "macro_f1",
      "per_class_precision_recall_f1",
      "confusion_matrix",
      "ece_15_bins",
      "multiclass_brier_score",
      "bootstrap_ci95_macro_f1"
    ],
    "internal_test_policy": "evaluate_once_after_model_selection_and_lock",
    "external_test_policy": "evaluate_once_after_campaign_and_external_set_lock",
    "report_internal_and_external_separately": true
  },
  "integrity_rules": [
    "External-test images and near duplicates must never enter training, validation, or internal holdout.",
    "Do not manually edit generated metrics, manifests or comparison tables.",
    "Do not use internal or external test results to select epochs, hyperparameters or architectures.",
    "Every run must preserve contract, manifest, dataset and checkpoint SHA256 values.",
    "Augmentation is dynamic and train-only; validation and test use deterministic preprocessing.",
    "Report mean and sample standard deviation across three seeds.",
    "Accuracy is secondary; Macro-F1 is the primary comparison metric."
  ]
}
